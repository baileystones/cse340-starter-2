<main class="container home">
  <section class="hero">
    <div class="hero-info">
      <h1>Welcome to CSE Motors!</h1>
      <a class="product-link" href="#">DMC Delorean</a>
      <ul class="features-list">
        <div>3 Cup holders</div>
        <div>Superman doors</div>
        <div>Fuzzy dice!</div>
      </ul>
      <a class="btn btn-primary" href="#">Own Today</a>
    </div>
    <div class="hero-image">
      <img src="/images/vehicles/delorean.jpg" alt="DMC Delorean car" />
    </div>
  </section>

  <section class="reviews">
    <h2>DMC Delorean Reviews</h2>
    <ul class="reviews-list">
      <li>"So fast it's almost like traveling in time." (4/5)</li>
      <li>"Coolest ride on the road." (4/5)</li>
      <li>"I'm feeling McFly!" (5/5)</li>
      <li>"The most futuristic ride of our day." (4.5/5)</li>
      <li>"80's livin and I love it!" (5/5)</li>
    </ul>
  </section>

  <section class="upgrades">
    <h2>Delorean Upgrades</h2>
    <div class="upgrades-grid">
      <div class="upgrade-item">
        <div class="upgrade-tile">
          <img src="/images/upgrades/flux-cap.png" alt="Flux Capacitor upgrade" />
        </div>
        <a href="#" class="upgrade-label">Flux Capacitor</a>
      </div>
      <div class="upgrade-item">
        <div class="upgrade-tile">
          <img src="/images/upgrades/flame.jpg" alt="Flame Decals upgrade" />
        </div>
        <a href="#" class="upgrade-label">Flame Decals</a>
      </div>
      <div class="upgrade-item">
        <div class="upgrade-tile">
          <img src="/images/upgrades/bumper_sticker.jpg" alt="Bumper Stickers upgrade" />
        </div>
        <a href="#" class="upgrade-label">Bumper Stickers</a>
      </div>
      <div class="upgrade-item">
        <div class="upgrade-tile">
          <img src="/images/upgrades/hub-cap.jpg" alt="Hub Caps upgrade" />
        </div>
        <a href="#" class="upgrade-label">Hub Caps</a>
      </div>
    </div>
  </section>
</main>