<h1><%= title %></h1>

<% if (messages()) { %>
  <%= messages() %>
<% } %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<form action="/account/register" method="post" class="account-form">
  <label>
    First Name
    <input type="text" name="account_firstname" value="<%= locals.account_firstname || '' %>" required>
  </label>

  <label>
    Last Name
    <input type="text" name="account_lastname" value="<%= locals.account_lastname || '' %>" required>
  </label>

  <label>
    Email Address
    <input type="email" name="account_email" value="<%= locals.account_email || '' %>" required>
  </label>

  <label>
    Password
    <span class="password-rules">
        Passwords must be at least 12 characters and include 1 capital letter, 1 number, and 1 special character.
    </span>

    <input
      type="password"
      name="account_password"
      required
      minlength="12"
      pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
      title="Passwords must be minimum of 12 characters and include 1 capital letter, 1 number, and 1 special character."
    >
  </label>

  <button type="submit">Register</button>
</form>

<p>
  Already have an account?
  <a href="/account">Login</a>
</p>