<h1><%= title %></h1>

<% if (messages()) { %>
  <%= messages() %>
<% } %>

<% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/inv/add-classification" method="post" class="classification-form">
  <label for="classification_name">
    Classification Name
  </label>
  <span class="form-hint">
    Classification name must not contain spaces or special characters.
  </span>

  <input
    type="text"
    id="classification_name"
    name="classification_name"
    required
    pattern="^[A-Za-z0-9]+$"
    title="Only letters and numbers are allowed. No spaces or special characters."
  >

  <button type="submit">Add Classification</button>
</form>
